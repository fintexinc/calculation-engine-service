<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!--
      Delegate to Spring Boot's default logback configuration so that
      `logging.level.*` and `logging.pattern.*` from application.yml
      (including MDC fields like traceId/spanId/requestId) are respected
      uniformly across all profiles. Per-environment level/pattern
      overrides belong in the application-*.yml files, not here.
    -->
    <include resource="org/springframework/boot/logging/logback/base.xml"/>

</configuration>
